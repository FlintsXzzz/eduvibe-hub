# Copy to .env.local and fill in real values. Never commit .env itself.
# These are VITE_-prefixed, so they are compiled into the public client bundle by design.
# Supabase anon/publishable keys are public by design - RLS policies are the real access control.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
